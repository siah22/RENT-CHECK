# Copy this file to .env for local development and fill in real values.
# In production (Render), set these as Environment Variables in the dashboard instead —
# never commit a real .env file.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local Postgres (used only when DATABASE_URL is not set)
DB_NAME=rentcheck
DB_USER=rentcheck_user
DB_PASSWORD=rentcheck_pass
DB_HOST=localhost
DB_PORT=5432

# Production database (e.g. from Neon: Dashboard -> Connection string).
# Must include ?sslmode=require. When set, this overrides the DB_* settings above.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Production image storage (from Cloudinary: Dashboard -> API Environment variable).
# When unset, uploaded images are stored on the local filesystem instead.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Absolute base URL used in outbound email/SMS links.
SITE_BASE_URL=https://rentcheck-tanzania.onrender.com

# Transactional email. Leave EMAIL_HOST empty to use the console backend
# (emails are printed to the server log instead of delivered).
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=<sendgrid/mailgun/ses smtp password>
DEFAULT_FROM_EMAIL=RentCheck <no-reply@rentcheck-tanzania.onrender.com>

# SMS alerts. provider: console (log only) | africastalking | twilio.
# Leave SMS_API_KEY empty to log messages instead of sending them.
SMS_PROVIDER=console
# SMS_API_KEY=<africastalking api key or twilio auth token>
# AT_SMS_USERNAME=<africastalking username>
# AT_SMS_FROM=<optional africa's talking short code>
# TWILIO_ACCOUNT_SID=<twilio account sid>
# TWILIO_AUTH_TOKEN=<twilio auth token>
# TWILIO_FROM_NUMBER=<twilio sender number, e.g. +15551234567>

# M-Pesa (Vodacom Tanzania Open API) payments. Leave MPESA_API_KEY empty to run
# in simulated mode (payments complete instantly, nothing sent to a phone).
# Get keys from the Vodacom Open API portal (developer account).
MPESA_API_KEY=
# MPESA_PUBLIC_KEY=<base64 platform public key from the portal>
MPESA_ENVIRONMENT=sandbox            # sandbox | openapi (production)
MPESA_BASE_URL=https://openapi.m-pesa.com
MPESA_MARKET=vodacomTZN
MPESA_COUNTRY=TZN
MPESA_CURRENCY=TZS
# MPESA_SERVICE_PROVIDER_CODE=<your M-Pesa business/short code>
MPESA_ORIGIN=*
MPESA_TIMEOUT=20
# Secret token appended to the confirmation callback URL when registering it
# with M-Pesa, e.g. https://rentcheck-tanzania.onrender.com/payments/callback/<token>/
MPESA_CALLBACK_TOKEN=
